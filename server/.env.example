# Copy this file to .env (never upload .env to GitHub)

# Hosted model: with a key the bot uses the API, without one the local Ollama
LLM_API_KEY=
# LLM_API_URL=https://api.groq.com/openai/v1
# Models in order; the next one is used when the free limit of the first is reached
# LLM_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
# LLM_REASONING_EFFORT=medium

# Reference contact the bot shares (filled into "$REFERENCE_..." in profile.json)
REFERENCE_NAME=
REFERENCE_PHONE=
REFERENCE_EMAIL=

# Contact form: messages are forwarded to this Discord webhook
DISCORD_WEBHOOK_URL=

# Only these websites may use the chat and contact form (comma-separated); empty allows all
# ALLOWED_ORIGINS=https://aliassem2812.github.io

# MAX_QUESTIONS_PER_HOUR=30
